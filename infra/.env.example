# === Telix_Secure_Pro — Configuration ===

# Base de données
POSTGRES_DB=telix
POSTGRES_USER=telix
POSTGRES_PASSWORD=changeme

# Redis (partagé entre auth-service et proxy-service pour le mapping IP->utilisateur)
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET=changeme_super_secret
JWT_EXPIRY_MINUTES=480

# Active Directory / LDAP
LDAP_SERVER=ldap://your-ad-server
LDAP_BASE_DN=DC=example,DC=com
LDAP_BIND_DN=CN=telix,OU=ServiceAccounts,DC=example,DC=com
LDAP_BIND_PASSWORD=changeme

# Azure AD
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# SMS Gateway (Kannel)
KANNEL_URL=http://kannel:13013/cgi-bin/sendsms
KANNEL_USER=telix
KANNEL_PASSWORD=changeme
SMS_SENDER=TelixSecure

# Proxy-service (Squid) -> Graylog (GELF/UDP)
GRAYLOG_HOST=log-service
GRAYLOG_GELF_PORT=12201

# Graylog
# GRAYLOG_PASSWORD_SECRET : chaine aleatoire >= 16 caracteres (secret de chiffrement interne Graylog)
#   generer avec : pwgen -N 1 -s 96
GRAYLOG_PASSWORD_SECRET=changeme_graylog_secret_96_chars_min_generate_with_pwgen
# GRAYLOG_ROOT_PASSWORD_SHA2 : SHA-256 du mot de passe admin, ex :
#   echo -n "VotreMotDePasse" | sha256sum
GRAYLOG_ROOT_PASSWORD_SHA2=changeme_sha256_hash_of_admin_password
# GRAYLOG_ROOT_PASSWORD_PLAIN : le meme mot de passe en clair, utilise uniquement
# par le conteneur de provisioning pour s'authentifier a l'API REST Graylog.
GRAYLOG_ROOT_PASSWORD_PLAIN=changeme_admin_password
# LOG_RETENTION_DAYS : duree de conservation des logs de trafic web (obligation 1 an)
LOG_RETENTION_DAYS=365

# Sekoia SIEM
SEKOIA_INTAKE_KEY=your-sekoia-intake-key
SEKOIA_SYSLOG_HOST=intake.sekoia.io
SEKOIA_SYSLOG_PORT=10514
